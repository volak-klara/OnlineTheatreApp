


@model List<OnlineTheatre.Domain.DomainModels.Show>

@{
    ViewData["Title"] = "Theatre Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int y = ViewBag.Year ?? DateTime.Now.Year;
    int m = ViewBag.Month ?? DateTime.Now.Month;

    var firstDay = new DateTime(y, m, 1);
    var lastDay = firstDay.AddMonths(1).AddDays(-1);

    int firstDayOfWeek = ((int)firstDay.DayOfWeek + 6) % 7; // Monday=0 ... Sunday=6
    var gridStart = firstDay.AddDays(-firstDayOfWeek);

    
    var days = Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i)).ToList();

   
    var showsByDate = (Model ?? new List<OnlineTheatre.Domain.DomainModels.Show>())
        .Where(s => s.StartTime >= DateTime.Now)
        .GroupBy(s => s.StartTime.Date)
        .ToDictionary(g => g.Key, g => g.OrderBy(x => x.StartTime).ToList());

    string monthTitle = firstDay.ToString("MMMM yyyy");

    // prev / next month
    var prev = firstDay.AddMonths(-1);
    var next = firstDay.AddMonths(1);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap');

    body {
        font-family: 'Montserrat', sans-serif;
    }

    .calendar-wrapper {
        min-height: 100vh;
        padding: 30px 20px;
    }

    .calendar-container {
        max-width: 1800px;
        margin: 0 auto;
    }

    /* Main Theatre Background */
    .theatre-bg {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 35px;
        background: rgba(10, 10, 12, 0.70);
        border: 1px solid rgba(255,255,255,0.10);
        box-shadow: 0 20px 70px rgba(0,0,0,0.50);
        backdrop-filter: blur(10px);
    }

        .theatre-bg::before {
            content: "";
            position: absolute;
            inset: -50px;
            background: radial-gradient(circle at 25% 20%, rgba(220,53,69,0.40), transparent 50%), radial-gradient(circle at 75% 30%, rgba(255,255,255,0.10), transparent 50%), radial-gradient(circle at 50% 90%, rgba(220,53,69,0.20), transparent 55%), linear-gradient(180deg, rgba(0,0,0,0.30), rgba(0,0,0,0.80));
            filter: blur(20px);
            transform: scale(1.1);
            z-index: 0;
            animation: bgPulse 8s ease-in-out infinite;
        }

    @@keyframes bgPulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.85;
    }

    }

    .theatre-content {
        position: relative;
        z-index: 1;
    }

    /* Page Title Section */
    .page-title {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .title-section h2 {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 800;
        margin: 0 0 8px 0;
        color: #fff;
        letter-spacing: 1px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .page-subtitle {
        color: rgba(255,255,255,0.75);
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.3px;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-theatre {
        background: linear-gradient(135deg, #dc3545 0%, #a82835 100%);
        border: 2px solid rgba(255,255,255,0.15);
        color: #fff;
        font-weight: 700;
        border-radius: 14px;
        padding: 12px 20px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(220,53,69,0.35);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-theatre:hover {
            background: linear-gradient(135deg, #e74c5c 0%, #c82333 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(220,53,69,0.5);
            color: #fff;
        }

    .btn-nav {
        background: rgba(255,255,255,0.10);
        border: 2px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.95);
        border-radius: 14px;
        padding: 12px 18px;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-nav:hover {
            background: rgba(255,255,255,0.15);
            border-color: rgba(220,53,69,0.5);
            color: #fff;
            transform: translateY(-2px);
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 12px;
        background: rgba(220,53,69,0.20);
        border: 2px solid rgba(220,53,69,0.40);
        color: rgba(255,255,255,0.95);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    /* Alerts */
    .alert {
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 25px;
        border: 2px solid;
        font-weight: 600;
        animation: slideIn 0.4s ease;
    }

    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .alert-success {
        background: rgba(40,167,69,0.15);
        border-color: rgba(40,167,69,0.4);
        color: #90EE90;
    }

    .alert-danger {
        background: rgba(220,53,69,0.15);
        border-color: rgba(220,53,69,0.4);
        color: #ff7b8a;
    }

    /* Calendar */
    .calendar {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.40);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
    }

    .calendar-header {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        background: rgba(255,255,255,0.08);
        border-bottom: 2px solid rgba(255,255,255,0.12);
    }

    .dow {
        padding: 16px 10px;
        font-weight: 800;
        color: rgba(255,255,255,0.90);
        text-transform: uppercase;
        font-size: 0.82rem;
        letter-spacing: 1.5px;
        text-align: center;
        border-right: 1px solid rgba(255,255,255,0.05);
    }

        .dow:last-child {
            border-right: none;
        }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        grid-auto-rows: 165px;
    }

    .day-cell {
        position: relative;
        padding: 12px;
        border-right: 1px solid rgba(255,255,255,0.08);
        border-bottom: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.02);
        transition: background 0.3s ease;
    }

        .day-cell:nth-child(7n) {
            border-right: none;
        }

        .day-cell:hover:not(.past-day) {
            background: rgba(255,255,255,0.04);
        }

    .day-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        font-weight: 800;
        color: rgba(255,255,255,0.95);
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.12);
        margin-bottom: 10px;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .muted-month .day-number {
        opacity: 0.30;
        background: rgba(255,255,255,0.04);
    }

    .today .day-number {
        background: linear-gradient(135deg, rgba(220,53,69,0.35) 0%, rgba(220,53,69,0.20) 100%);
        border-color: rgba(220,53,69,0.70);
        box-shadow: 0 0 0 4px rgba(220,53,69,0.15), 0 4px 12px rgba(220,53,69,0.3);
        animation: todayPulse 2s ease-in-out infinite;
    }

    @@keyframes todayPulse {
        0%, 100%

    {
        box-shadow: 0 0 0 4px rgba(220,53,69,0.15), 0 4px 12px rgba(220,53,69,0.3);
    }

    50% {
        box-shadow: 0 0 0 6px rgba(220,53,69,0.25), 0 6px 16px rgba(220,53,69,0.4);
    }

    }

    /* Past days styling */
    .past-day {
        opacity: 0.35;
    }

        .past-day .events {
            pointer-events: none;
        }

        .past-day .day-number {
            background: rgba(100,100,100,0.15);
            border-color: rgba(100,100,100,0.20);
        }

    /* Events */
    .events {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 110px;
        overflow: hidden;
    }

    .event {
        display: block;
        text-decoration: none;
        border-radius: 10px;
        padding: 10px 12px;
        background: rgba(0,0,0,0.60);
        border: 1px solid rgba(220,53,69,0.30);
        color: rgba(255,255,255,0.95);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .event::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, #dc3545, #a82835);
            opacity: 0.6;
            transition: opacity 0.25s ease;
        }

        .event:hover {
            transform: translateY(-2px);
            background: rgba(0,0,0,0.80);
            border-color: rgba(220,53,69,0.60);
            color: #fff;
            box-shadow: 0 6px 20px rgba(220,53,69,0.25);
        }

            .event:hover::before {
                opacity: 1;
            }

    .event-title {
        font-weight: 700;
        font-size: 0.93rem;
        line-height: 1.2;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .event-meta {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.75);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .event-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .event-price {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 700;
        color: #dc3545;
    }

    .more-events {
        color: rgba(255,255,255,0.55);
        font-size: 0.82rem;
        margin-top: 4px;
        font-weight: 600;
        text-align: center;
        padding: 4px;
        background: rgba(255,255,255,0.03);
        border-radius: 6px;
    }

    /* Footer Tip */
    .calendar-tip {
        margin-top: 20px;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.70);
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .calendar-tip::before {
            content: "💡";
            font-size: 1.3rem;
        }

    /* Responsive */
    @@media (max-width: 1200px) {
        .calendar-grid

    {
        grid-auto-rows: 180px;
    }

    }

    @@media (max-width: 768px) {
        .page-title

    {
        flex-direction: column;
        align-items: flex-start;
    }

    .title-section h2 {
        font-size: 2.2rem;
    }

    .action-buttons {
        width: 100%;
    }

    .btn-theatre,
    .btn-nav {
        flex: 1;
        justify-content: center;
    }

    .calendar-grid {
        grid-auto-rows: 140px;
    }

    .day-number {
        width: 32px;
        height: 32px;
        font-size: 0.9rem;
    }

    .event {
        padding: 8px 10px;
    }

    .event-title {
        font-size: 0.85rem;
    }

    .event-meta {
        font-size: 0.75rem;
    }

    .theatre-bg {
        padding: 20px;
    }

    }

    @@media (max-width: 480px) {
        .calendar-grid

    {
        grid-auto-rows: 120px;
    }

    .events {
        gap: 5px;
        max-height: 80px;
    }

    .event {
        padding: 6px 8px;
    }

    .day-number {
        width: 28px;
        height: 28px;
        font-size: 0.8rem;
    }

    }
</style>

<div class="calendar-wrapper">
    <div class="calendar-container">
        <div class="theatre-bg">
            <div class="theatre-content">

                <!-- Page Title -->
                <div class="page-title">
                    <div class="title-section">
                        <h2>@monthTitle</h2>
                        <div class="page-subtitle">Прелистајте ги претстојните театарски претстави по месец</div>
                    </div>

                    <div class="action-buttons">
                        <a class="btn-nav"
                           asp-controller="Shows"
                           asp-action="Index"
                           asp-route-year="@prev.Year"
                           asp-route-month="@prev.Month">
                            ← Претходен
                        </a>

                        <a class="btn-nav"
                           asp-controller="Shows"
                           asp-action="Index"
                           asp-route-year="@next.Year"
                           asp-route-month="@next.Month">
                            Следен →
                        </a>

                        <span class="pill">🎭 Театар</span>

                        @* <a asp-action="ImportFromApi" class="btn-theatre"> *@
                        @*     📥 Import shows *@
                        @* </a> *@
                      

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="ImportFromSeatGeek" class="btn btn-danger">
                                📥 Import shows 
                            </a>
                        }
                    </div>
                </div>

                <!-- Alerts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">✅ @TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
                }

                <!-- Calendar -->
                <div class="calendar">
                    <div class="calendar-header">
                        <div class="dow">Пон</div>
                        <div class="dow">Вто</div>
                        <div class="dow">Сре</div>
                        <div class="dow">Чет</div>
                        <div class="dow">Пет</div>
                        <div class="dow">Саб</div>
                        <div class="dow">Нед</div>
                    </div>

                    <div class="calendar-grid">
                        @foreach (var day in days)
                        {
                            var isCurrentMonth = day.Month == firstDay.Month;
                            var isToday = day.Date == DateTime.Today;
                            var isPastDay = day.Date < DateTime.Today;

                            <div class="day-cell @(isCurrentMonth ? "" : "muted-month") @(isToday ? "today" : "") @(isPastDay ? "past-day" : "")">
                                <div class="day-number">@day.Day</div>

                                <div class="events">
                                    @{
                                        if (!isPastDay && showsByDate.TryGetValue(day.Date, out var dayShows))
                                        {
                                            foreach (var show in dayShows.Take(3))
                                            {
                                                <a style="" class="event"
                                                   asp-controller="Shows"
                                                   asp-action="Details"
                                                   asp-route-id="@show.Id"
                                                   title="@show.Titile">

                                                    @{
                                                        var shortTitle = show.Titile?.Length > 28 ? show.Titile.Substring(0, 10) + "..." : show.Titile;
                                                    }
                                                    <div class="event-title" title="@show.Titile">@shortTitle</div>
                                                    <div class="event-meta">
                                                        <span class="event-time">🕐 @show.StartTime.ToString("HH:mm")</span>
                                                        <span class="event-price">💰 @show.BasePrice ден</span>
                                                    </div>
                                                </a>
                                            }

                                            if (dayShows.Count > 3)
                                            {
                                                <div class="more-events">
                                                    +@(dayShows.Count - 3) повеќе
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                
                <div class="calendar-tip">
                    <strong>Совет:</strong> Користете ги копчињата Претходен/Следен за да ги менувате месеците. Минатите претстави се скриени.
                </div>

            </div>
        </div>
    </div>
</div>

