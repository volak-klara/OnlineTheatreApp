


@model List<OnlineTheatre.Domain.DTO.PurchasedTicketDTO>

@{
    ViewData["Title"] = "My Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap');

    body {
        font-family: 'Montserrat', sans-serif;
    }

    .tickets-wrapper {
        min-height: 100vh;
        padding: 40px 20px;
    }

    .tickets-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 40px;
        text-align: center;
    }

    .page-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        animation: ticketFloat 3s ease-in-out infinite;
    }

    @@keyframes ticketFloat {
        0%, 100%

    {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-10px) rotate(5deg);
    }

    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 15px 0;
        letter-spacing: 1px;
    }

    .page-subtitle {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.75);
        font-weight: 500;
    }

    /* Tickets Grid */
    .tickets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    /* Ticket Card */
    .ticket-card {
        background: rgba(10, 10, 12, 0.75);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.50);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        animation: ticketFadeIn 0.6s ease-out;
        cursor: pointer;
    }

    @@keyframes ticketFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .ticket-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 80px rgba(220,53,69,0.35);
        border-color: rgba(220,53,69,0.40);
    }

    /* Ticket Top Section */
    .ticket-top {
        background: linear-gradient(135deg, rgba(220,53,69,0.40) 0%, rgba(139,0,0,0.25) 100%);
        padding: 25px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .ticket-top::before {
            content: "";
            position: absolute;
            top: -2px;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, transparent, rgba(220,53,69,0.9) 25%, rgba(220,53,69,0.9) 75%, transparent);
            box-shadow: 0 0 20px rgba(220,53,69,0.7);
        }

    .ticket-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 12px;
        line-height: 1.3;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .ticket-seat {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.30);
        border-radius: 12px;
        font-weight: 800;
        font-size: 1.1rem;
        color: #fff;
        backdrop-filter: blur(10px);
    }

   
    .ticket-qr-section {
        padding: 30px;
        background: rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .qr-container {
        width: 200px;
        height: 200px;
        background: #fff;
        border-radius: 18px;
        padding: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }

        .qr-container:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(220,53,69,0.4);
        }

        .qr-container::after {
            content: "🔍 Кликни за зголемување";
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.85rem;
            color: rgba(255,255,255,0.60);
            font-weight: 600;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .qr-container:hover::after {
            opacity: 1;
        }

        .qr-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .qr-placeholder {
        color: rgba(0,0,0,0.3);
        font-weight: 700;
        font-size: 0.9rem;
    }

    .qr-label {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.70);
        font-weight: 600;
        text-align: center;
        margin-top: 15px;
    }

    
    .ticket-details {
        padding: 25px;
        display: grid;
        gap: 15px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.60);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .detail-value {
        font-size: 1rem;
        color: rgba(255,255,255,0.95);
        font-weight: 700;
    }

   
    .ticket-footer {
        padding: 20px 25px;
        background: rgba(255,255,255,0.03);
        border-top: 1px solid rgba(255,255,255,0.10);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.65);
        font-weight: 600;
    }

    .order-id {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Courier New', monospace;
        color: rgba(255,255,255,0.80);
    }

   
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: rgba(10, 10, 12, 0.75);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.50);
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 25px;
        opacity: 0.5;
    }

    .empty-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: rgba(255,255,255,0.85);
        margin-bottom: 15px;
    }

    .empty-text {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.60);
        margin-bottom: 35px;
    }

    .btn-browse-shows {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        background: linear-gradient(135deg, #dc3545 0%, #a82835 100%);
        border: 2px solid rgba(255,255,255,0.15);
        color: #fff;
        font-weight: 700;
        border-radius: 14px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(220,53,69,0.35);
        font-size: 1.05rem;
    }

        .btn-browse-shows:hover {
            background: linear-gradient(135deg, #e74c5c 0%, #c82333 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(220,53,69,0.5);
            color: #fff;
        }

    
    .qr-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(15px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: modalFadeIn 0.3s ease;
    }

    @@keyframes modalFadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    .qr-modal.active {
        display: flex;
    }

    .qr-modal-content {
        background: rgba(20, 20, 25, 0.95);
        border: 2px solid rgba(220,53,69,0.40);
        border-radius: 28px;
        padding: 40px;
        max-width: 600px;
        width: 100%;
        text-align: center;
        box-shadow: 0 30px 100px rgba(0,0,0,0.8);
        position: relative;
        animation: modalSlideUp 0.4s ease;
    }

    @@keyframes modalSlideUp {
        from

    {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 40px;
        height: 40px;
        background: rgba(220,53,69,0.20);
        border: 2px solid rgba(220,53,69,0.40);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .modal-close:hover {
            background: rgba(220,53,69,0.40);
            transform: rotate(90deg);
        }

    .modal-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 15px;
    }

    .modal-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,0.70);
        margin-bottom: 30px;
    }

    .modal-qr-container {
        width: 400px;
        height: 400px;
        max-width: 100%;
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        margin: 0 auto 25px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    }

        .modal-qr-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .modal-instruction {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.85);
        font-weight: 600;
        padding: 18px;
        background: rgba(40,167,69,0.15);
        border: 2px solid rgba(40,167,69,0.35);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    
    @@media (max-width: 768px) {
        .tickets-grid

    {
        grid-template-columns: 1fr;
    }

    .page-title {
        font-size: 2.5rem;
    }

    .ticket-card {
        max-width: 500px;
        margin: 0 auto;
    }

    .qr-modal-content {
        padding: 30px 20px;
    }

    .modal-qr-container {
        width: 300px;
        height: 300px;
    }

    .modal-title {
        font-size: 1.6rem;
    }

    }
</style>

<div class="tickets-wrapper">
    <div class="tickets-container">

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-icon">🎫</div>
            <h1 class="page-title">Мои Билети</h1>
            <p class="page-subtitle">Сите ваши резервирани билети на едно место</p>
        </div>

        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">🎭</div>
                <h2 class="empty-title">Немате активни билети</h2>
                <p class="empty-text">Резервирајте билети за најдобрите театарски претстави</p>
                <a asp-controller="Shows" asp-action="Index" class="btn-browse-shows">
                    <span>🎭</span>
                    <span>Прелистај Репертоар</span>
                </a>
            </div>
        }
        else
        {
            <!-- Tickets Grid -->
            <div class="tickets-grid">
                @foreach (var ticket in Model)
                {
                    <div class="ticket-card">
                        <!-- Ticket Top -->
                        <div class="ticket-top">
                            <h3 class="ticket-title">@ticket.ShowTitle</h3>
                            <div class="ticket-seat">
                                <span>🪑</span>
                                <span>@ticket.SeatLabel</span>
                            </div>
                        </div>

                        <!-- QR Section -->
                        <div class="ticket-qr-section">
                            <div class="qr-container" onclick="openQRModal('@ticket.OrderId', '@ticket.ShowTitle', '@ticket.QrPngBase64')">
                                @if (!string.IsNullOrEmpty(ticket.QrPngBase64))
                                {
                                    <img src="data:image/png;base64,@ticket.QrPngBase64" alt="QR Code" />
                                }
                                else
                                {
                                    <div class="qr-placeholder">No QR</div>
                                }
                            </div>
                            <div class="qr-label">Кликни на QR кодот за зголемување</div>
                        </div>

                        <!-- Ticket Details -->
                        <div class="ticket-details">
                            <div class="detail-row">
                                <span class="detail-label">📅 Датум</span>
                                <span class="detail-value">@ticket.StartTime.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">🕐 Почеток</span>
                                <span class="detail-value">@ticket.StartTime.ToString("HH:mm")</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">⏱️ Крај</span>
                                <span class="detail-value">@ticket.EndTime.ToString("HH:mm")</span>
                            </div>
                            @* <div class="detail-row"> *@
                            @*     <span class="detail-label">💰 Цена</span> *@
                            @*     <span class="detail-value">@ticket.Price ден</span> *@
                            @* </div> *@
                        </div>

                        <!-- Ticket Footer -->
                        <div class="ticket-footer">
                            <span>✅ Валиден билет</span>
                            <span class="order-id">
                                <span>#</span>
                                <span>@ticket.OrderId.ToString().Substring(0, 8)</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<!-- QR Modal -->
<div class="qr-modal" id="qrModal" onclick="closeQRModal(event)">
    <div class="qr-modal-content" onclick="event.stopPropagation()">
        <div class="modal-close" onclick="closeQRModal(event)">×</div>

        <h2 class="modal-title" id="modalShowTitle">QR Код</h2>
        <p class="modal-subtitle">Покажете го овој код на влезот</p>

        <div class="modal-qr-container">
            <img id="modalQRImage" src="" alt="QR Code" />
        </div>

        
    </div>
</div>

<script>
    function openQRModal(orderId, showTitle, qrBase64) {
        const modal = document.getElementById('qrModal');
        const modalTitle = document.getElementById('modalShowTitle');
        const modalQR = document.getElementById('modalQRImage');

        modalTitle.textContent = showTitle;
        modalQR.src = 'data:image/png;base64,' + qrBase64;

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeQRModal(event) {
        const modal = document.getElementById('qrModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    // Close modal on ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeQRModal(event);
        }
    });
</script>
