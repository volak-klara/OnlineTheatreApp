

@model List<OnlineTheatre.Domain.DTO.PurchasedTicketDTO>

@{
    ViewData["Title"] = "Ticket History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .history-wrapper {
        max-width: 1100px;
        margin: 40px auto;
    }

    .history-title {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .history-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 16px;
        color: rgba(255,255,255,0.85);
    }

    .history-show {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .history-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.65);
    }

    .btn-back {
        margin-top: 30px;
    }
</style>

<div class="history-wrapper">

    <h2 class="history-title">📜 Ticket History</h2>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p>Немате историја на купени билети.</p>
        </div>
    }
    else
    {
        foreach (var ticket in Model)
        {
            <div class="history-card">
                <div class="history-show">@ticket.ShowTitle</div>

                <div class="history-meta">
                    <div>📅 @ticket.StartTime.ToString("dd.MM.yyyy")</div>
                    <div>🕐 @ticket.StartTime.ToString("HH:mm")</div>
                    <div>🎟️ Seat @ticket.SeatLabel</div>
                    <div>💰 @ticket.Price ден</div>
                </div>
            </div>
        }
    }

    <a asp-action="MyTickets" class="btn btn-outline-light btn-back">
        ← Back to active tickets
    </a>
</div>
