@{
    ViewData["Title"] = "Success";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap');

    body {
        font-family: 'Montserrat', sans-serif;
    }

    .success-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .success-container {
        max-width: 700px;
        width: 100%;
        text-align: center;
    }

    /* Success Card */
    .success-card {
        background: rgba(10, 10, 12, 0.80);
        border: 2px solid rgba(40,167,69,0.40);
        border-radius: 28px;
        padding: 60px 40px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.60);
        position: relative;
        overflow: hidden;
        animation: cardFadeIn 0.8s ease-out;
    }

    @@keyframes cardFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .success-card::before {
        content: "";
        position: absolute;
        inset: -50px;
        background: radial-gradient(circle at 50% 50%, rgba(40,167,69,0.20), transparent 70%);
        filter: blur(40px);
        z-index: 0;
        animation: glowPulse 3s ease-in-out infinite;
    }

    @@keyframes glowPulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.6;
    }

    }

    .success-content {
        position: relative;
        z-index: 1;
    }

    /* Success Icon */
    .success-icon-container {
        margin-bottom: 35px;
        position: relative;
    }

    .success-icon {
        font-size: 6rem;
        animation: iconBounce 1s ease-out, iconRotate 0.8s ease-out;
        display: inline-block;
        filter: drop-shadow(0 10px 40px rgba(40,167,69,0.6));
    }

    @@keyframes iconBounce {
        0%

    {
        transform: scale(0) translateY(-50px);
        opacity: 0;
    }

    50% {
        transform: scale(1.2) translateY(0);
    }

    100% {
        transform: scale(1) translateY(0);
        opacity: 1;
    }

    }

    @@keyframes iconRotate {
        0%

    {
        transform: rotate(-180deg);
    }

    100% {
        transform: rotate(0deg);
    }

    }

    /* Confetti Animation */
    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        background: #28a745;
        animation: confettiFall 3s ease-out infinite;
    }

    @@keyframes confettiFall {
        0%

    {
        transform: translateY(-100px) rotate(0deg);
        opacity: 1;
    }

    100% {
        transform: translateY(600px) rotate(720deg);
        opacity: 0;
    }

    }

    .confetti:nth-child(1) {
        left: 10%;
        background: #28a745;
        animation-delay: 0s;
    }

    .confetti:nth-child(2) {
        left: 20%;
        background: #dc3545;
        animation-delay: 0.3s;
    }

    .confetti:nth-child(3) {
        left: 30%;
        background: #ffc107;
        animation-delay: 0.6s;
    }

    .confetti:nth-child(4) {
        left: 40%;
        background: #17a2b8;
        animation-delay: 0.9s;
    }

    .confetti:nth-child(5) {
        left: 50%;
        background: #28a745;
        animation-delay: 1.2s;
    }

    .confetti:nth-child(6) {
        left: 60%;
        background: #dc3545;
        animation-delay: 0.2s;
    }

    .confetti:nth-child(7) {
        left: 70%;
        background: #ffc107;
        animation-delay: 0.5s;
    }

    .confetti:nth-child(8) {
        left: 80%;
        background: #17a2b8;
        animation-delay: 0.8s;
    }

    .confetti:nth-child(9) {
        left: 90%;
        background: #28a745;
        animation-delay: 1.1s;
    }

    /* Title and Text */
    .success-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 20px 0;
        letter-spacing: 1px;
        animation: titleSlideIn 0.8s ease-out 0.3s both;
    }

    @@keyframes titleSlideIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .success-message {
        font-size: 1.3rem;
        color: rgba(255,255,255,0.85);
        margin-bottom: 20px;
        line-height: 1.6;
        animation: messageSlideIn 0.8s ease-out 0.5s both;
    }

    @@keyframes messageSlideIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .success-submessage {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.70);
        margin-bottom: 45px;
        animation: messageSlideIn 0.8s ease-out 0.7s both;
    }

    /* Success Badge */
    .success-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: rgba(40,167,69,0.20);
        border: 2px solid rgba(40,167,69,0.50);
        border-radius: 14px;
        color: #90EE90;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 45px;
        animation: badgeSlideIn 0.8s ease-out 0.9s both;
    }

    @@keyframes badgeSlideIn {
        from

    {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        animation: buttonsSlideIn 0.8s ease-out 1.1s both;
    }

    @@keyframes buttonsSlideIn {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 18px 36px;
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

        .btn-action::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .btn-action:hover::before {
            opacity: 1;
        }

    .btn-primary-action {
        background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
        border-color: rgba(40,167,69,0.50);
        color: #fff;
        box-shadow: 0 8px 30px rgba(40,167,69,0.40);
    }

        .btn-primary-action:hover {
            background: linear-gradient(135deg, #34ce57 0%, #28a745 100%);
            border-color: rgba(40,167,69,0.80);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(40,167,69,0.60);
            color: #fff;
        }

    .btn-secondary-action {
        background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.08) 100%);
        border-color: rgba(255,255,255,0.25);
        color: #fff;
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }

        .btn-secondary-action:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.20) 0%, rgba(255,255,255,0.15) 100%);
            border-color: rgba(255,255,255,0.40);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(255,255,255,0.15);
            color: #fff;
        }

    .btn-icon {
        font-size: 1.4rem;
    }

    /* Additional Info */
    .additional-info {
        margin-top: 45px;
        padding-top: 35px;
        border-top: 1px solid rgba(255,255,255,0.10);
        animation: infoSlideIn 0.8s ease-out 1.3s both;
    }

    @@keyframes infoSlideIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    .info-text {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.60);
        line-height: 1.6;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .success-card

    {
        padding: 50px 30px;
    }

    .success-title {
        font-size: 2.5rem;
    }

    .success-message {
        font-size: 1.1rem;
    }

    .success-icon {
        font-size: 5rem;
    }

    .action-buttons {
        flex-direction: column;
        width: 100%;
    }

    .btn-action {
        width: 100%;
        justify-content: center;
    }

    }

    @@media (max-width: 480px) {
        .success-title

    {
        font-size: 2rem;
    }

    .success-icon {
        font-size: 4rem;
    }

    .success-card {
        padding: 40px 20px;
    }

    }
</style>

<div class="success-wrapper">
    <div class="success-container">

        <!-- Confetti -->
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>
        <div class="confetti"></div>

        <!-- Success Card -->
        <div class="success-card">
            <div class="success-content">

                <!-- Success Icon -->
                <div class="success-icon-container">
                    <div class="success-icon">🎉</div>
                </div>

                <!-- Title -->
                <h1 class="success-title">Успешно!</h1>

                <!-- Message -->
                <p class="success-message">
                    Вашите билети се успешно резервирани
                </p>

                <p class="success-submessage">
                    Можете да ги погледнете вашите билети во секое време
                </p>

                <!-- Success Badge -->
                <div class="success-badge">
                    <span>✅</span>
                    <span>Нарачката е потврдена</span>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <a asp-controller="Orders" asp-action="MyTickets" class="btn-action btn-primary-action">
                        <span class="btn-icon">🎫</span>
                        <span>Погледни Мои Билети</span>
                    </a>

                    <a asp-controller="Shows" asp-action="Index" class="btn-action btn-secondary-action">
                        <span class="btn-icon">📅</span>
                        <span>Назад до Репертоар</span>
                    </a>
                </div>

                <!-- Additional Info -->
                <div class="additional-info">
                    <p class="info-text">
                        <span>💡</span>
                        <span>Не заборавајте да го понесете QR кодот при влез во театарот</span>
                    </p>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
