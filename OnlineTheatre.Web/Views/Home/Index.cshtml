


 @model List<OnlineTheatre.Domain.DomainModels.Show>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int y = ViewBag.Year ?? DateTime.Now.Year;
    int m = ViewBag.Month ?? DateTime.Now.Month;

    var firstDay = new DateTime(y, m, 1);
    int firstDayOfWeek = ((int)firstDay.DayOfWeek + 6) % 7;
    var gridStart = firstDay.AddDays(-firstDayOfWeek);
    var days = Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i)).ToList();

    var showsByDate = (Model ?? new List<OnlineTheatre.Domain.DomainModels.Show>())
        .Where(s => s.StartTime >= DateTime.Now)
        .GroupBy(s => s.StartTime.Date)
        .ToDictionary(g => g.Key, g => g.OrderBy(x => x.StartTime).ToList());

    var prev = firstDay.AddMonths(-1);
    var next = firstDay.AddMonths(1);
    string monthTitle = firstDay.ToString("MMMM yyyy");
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&display=swap');

    body {
        font-family: 'Montserrat', sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #0a0a0c;
    }

    /* Full page background */
    .page-background {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: linear-gradient(135deg, rgba(0,0,0,0.85) 0%, rgba(10,10,12,0.90) 100%), url('https://images.unsplash.com/photo-1503095396549-807759245b35?q=80&w=2071') center/cover no-repeat;
        filter: blur(0px);
    }

        .page-background::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 20%, rgba(220,53,69,0.20), transparent 60%), radial-gradient(circle at 70% 80%, rgba(139,0,0,0.15), transparent 60%);
            animation: ambientGlow 8s ease-in-out infinite;
        }

    @@keyframes ambientGlow {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.7;
    }

    }

    .home-wrapper {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .home-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    /* Hero Section */
    .hero-section {
        text-align: center;
        padding: 80px 20px 60px;
        margin-bottom: 50px;
        position: relative;
    }

    .hero-icon {
        font-size: 5rem;
        margin-bottom: 25px;
        animation: theatrePulse 3s ease-in-out infinite;
        filter: drop-shadow(0 10px 30px rgba(220,53,69,0.5));
    }

    @@keyframes theatrePulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 5rem;
        font-weight: 900;
        margin: 0 0 20px 0;
        color: #fff;
        letter-spacing: 2px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.5);
        background: linear-gradient(135deg, #fff 0%, #dc3545 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: titleFadeIn 1.5s ease-out;
    }

    @@keyframes titleFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .hero-subtitle {
        font-size: 1.4rem;
        color: rgba(255,255,255,0.85);
        font-weight: 400;
        max-width: 800px;
        margin: 0 auto 40px;
        line-height: 1.8;
        animation: subtitleFadeIn 1.5s ease-out 0.3s both;
    }

    @@keyframes subtitleFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .hero-tagline {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.70);
        font-weight: 300;
        font-style: italic;
        margin-bottom: 50px;
        animation: subtitleFadeIn 1.5s ease-out 0.6s both;
    }

    /* Auth Buttons */
    .auth-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 60px;
        flex-wrap: wrap;
        animation: buttonsFadeIn 1.5s ease-out 0.9s both;
    }

    @@keyframes buttonsFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .btn-auth {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 18px 40px;
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        border: 2px solid transparent;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-auth::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .btn-auth:hover::before {
            opacity: 1;
        }

    .btn-login {
        background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.08) 100%);
        border-color: rgba(255,255,255,0.25);
        color: #fff;
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }

        .btn-login:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.20) 0%, rgba(255,255,255,0.15) 100%);
            border-color: rgba(255,255,255,0.40);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(255,255,255,0.15);
            color: #fff;
        }

    .btn-register {
        background: linear-gradient(135deg, #dc3545 0%, #a82835 100%);
        border-color: rgba(220,53,69,0.50);
        color: #fff;
        box-shadow: 0 8px 30px rgba(220,53,69,0.4);
    }

        .btn-register:hover {
            background: linear-gradient(135deg, #e74c5c 0%, #c82333 100%);
            border-color: rgba(220,53,69,0.80);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(220,53,69,0.6);
            color: #fff;
        }

    .btn-icon {
        font-size: 1.3rem;
    }

    /* Divider */
    .section-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: 50px 0;
        animation: dividerFadeIn 1.5s ease-out 1.2s both;
    }

    @@keyframes dividerFadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    .divider-line {
        height: 2px;
        width: 200px;
        background: linear-gradient(90deg, transparent, rgba(220,53,69,0.5), transparent);
    }

    .divider-text {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: rgba(255,255,255,0.80);
        text-transform: uppercase;
        letter-spacing: 3px;
    }

    /* Calendar Section */
    .calendar-section {
        animation: calendarFadeIn 1.5s ease-out 1.5s both;
    }

    @@keyframes calendarFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .calendar-header-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .calendar-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
        letter-spacing: 1px;
    }

    .calendar-nav {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-nav {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: rgba(255,255,255,0.10);
        border: 2px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.95);
        border-radius: 14px;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 600;
        font-size: 0.95rem;
    }

        .btn-nav:hover {
            background: rgba(255,255,255,0.15);
            border-color: rgba(220,53,69,0.5);
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-primary-nav {
        background: linear-gradient(135deg, #dc3545 0%, #a82835 100%);
        border-color: rgba(220,53,69,0.50);
        box-shadow: 0 5px 20px rgba(220,53,69,0.35);
    }

        .btn-primary-nav:hover {
            background: linear-gradient(135deg, #e74c5c 0%, #c82333 100%);
            border-color: rgba(220,53,69,0.80);
            box-shadow: 0 8px 25px rgba(220,53,69,0.5);
        }

    /* Calendar Container */
    .theatre-bg {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 35px;
        background: rgba(10, 10, 12, 0.75);
        border: 1px solid rgba(255,255,255,0.10);
        box-shadow: 0 20px 70px rgba(0,0,0,0.60);
        backdrop-filter: blur(20px);
    }

        .theatre-bg::before {
            content: "";
            position: absolute;
            inset: -50px;
            background: radial-gradient(circle at 25% 20%, rgba(220,53,69,0.30), transparent 50%), radial-gradient(circle at 75% 80%, rgba(139,0,0,0.20), transparent 50%);
            filter: blur(25px);
            transform: scale(1.1);
            z-index: 0;
        }

    .theatre-content {
        position: relative;
        z-index: 1;
    }

    .calendar {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.40);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
    }

    .calendar-header {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        background: rgba(255,255,255,0.08);
        border-bottom: 2px solid rgba(255,255,255,0.12);
    }

    .dow {
        padding: 16px 10px;
        font-weight: 800;
        color: rgba(255,255,255,0.90);
        text-transform: uppercase;
        font-size: 0.82rem;
        letter-spacing: 1.5px;
        text-align: center;
        border-right: 1px solid rgba(255,255,255,0.05);
    }

        .dow:last-child {
            border-right: none;
        }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        grid-auto-rows: 150px;
    }

    .day-cell {
        position: relative;
        padding: 12px;
        border-right: 1px solid rgba(255,255,255,0.08);
        border-bottom: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.02);
        transition: background 0.3s ease;
    }

        .day-cell:nth-child(7n) {
            border-right: none;
        }

        .day-cell:hover:not(.past-day) {
            background: rgba(255,255,255,0.04);
        }

    .day-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 12px;
        font-weight: 800;
        color: rgba(255,255,255,0.95);
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.12);
        margin-bottom: 10px;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .muted-month .day-number {
        opacity: 0.30;
        background: rgba(255,255,255,0.04);
    }

    .past-day {
        opacity: 0.35;
    }

        .past-day .events {
            pointer-events: none;
        }

        .past-day .day-number {
            background: rgba(100,100,100,0.15);
            border-color: rgba(100,100,100,0.20);
        }

    .events {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 100px;
        overflow: hidden;
    }

    .event {
        display: block;
        text-decoration: none;
        border-radius: 10px;
        padding: 10px 12px;
        background: rgba(0,0,0,0.60);
        border: 1px solid rgba(220,53,69,0.30);
        color: rgba(255,255,255,0.95);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .event::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, #dc3545, #a82835);
            opacity: 0.6;
            transition: opacity 0.25s ease;
        }

        .event:hover {
            transform: translateY(-2px);
            background: rgba(0,0,0,0.80);
            border-color: rgba(220,53,69,0.60);
            color: #fff;
            box-shadow: 0 6px 20px rgba(220,53,69,0.25);
        }

            .event:hover::before {
                opacity: 1;
            }

    .event-title {
        font-weight: 700;
        font-size: 0.93rem;
        line-height: 1.2;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .event-meta {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.75);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .event-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .event-price {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 700;
        color: #dc3545;
    }

    .calendar-footer {
        margin-top: 25px;
        padding: 20px;
        background: rgba(255,255,255,0.04);
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.70);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .calendar-footer::before {
            content: "💡";
            font-size: 1.3rem;
        }

    /* Responsive */
    @@media (max-width: 1200px) {
        .calendar-grid

    {
        grid-auto-rows: 140px;
    }

    }

    @@media (max-width: 768px) {
        .hero-title

    {
        font-size: 3rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
    }

    .auth-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-auth {
        width: 100%;
        justify-content: center;
    }

    .calendar-header-section {
        flex-direction: column;
        align-items: flex-start;
    }

    .calendar-title {
        font-size: 2rem;
    }

    .calendar-nav {
        width: 100%;
    }

    .btn-nav {
        flex: 1;
        justify-content: center;
    }

    .calendar-grid {
        grid-auto-rows: 130px;
    }

    .day-number {
        width: 32px;
        height: 32px;
        font-size: 0.9rem;
    }

    .event {
        padding: 8px 10px;
    }

    .event-title {
        font-size: 0.85rem;
    }

    .theatre-bg {
        padding: 25px;
    }

    }

    @@media (max-width: 480px) {
        .hero-section

    {
        padding: 60px 20px 40px;
    }

    .hero-title {
        font-size: 2.5rem;
    }

    .calendar-grid {
        grid-auto-rows: 110px;
    }

    .day-number {
        width: 28px;
        height: 28px;
        font-size: 0.8rem;
    }

    .divider-line {
        width: 80px;
    }

    }
</style>

<div class="page-background"></div>

<div class="home-wrapper">
    <div class="home-container">

        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-icon">🎭</div>
            <h1 class="hero-title">Online Theatre</h1>
            <p class="hero-subtitle">
                Откријте го магичниот свет на театарот. Резервирајте ги вашите седишта за најдобрите претстави во градот.
            </p>
            <p class="hero-tagline">"Животот е театар, а ние сме актерите"</p>

            <!-- Auth Buttons -->
            <div class="auth-buttons">
                <a href="/Identity/Account/Login" class="btn-auth btn-login">
                    <span class="btn-icon">🔐</span>
                    <span>Најава</span>
                </a>
                <a href="/Identity/Account/Register" class="btn-auth btn-register">
                    <span class="btn-icon">✨</span>
                    <span>Регистрација</span>
                </a>
            </div>
        </div>

        <!-- Divider -->
        <div class="section-divider">
            <div class="divider-line"></div>
            <div class="divider-text">Репертоар</div>
            <div class="divider-line"></div>
        </div>

        <!-- Calendar Section -->
        <div class="calendar-section">
            <div class="calendar-header-section">
                <h2 class="calendar-title">📅 @monthTitle</h2>

                <div class="calendar-nav">
                    <a class="btn-nav"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-year="@prev.Year"
                       asp-route-month="@prev.Month">
                        ← Претходен
                    </a>

                    <a class="btn-nav"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-year="@next.Year"
                       asp-route-month="@next.Month">
                        Следен →
                    </a>

                    <a class="btn-nav btn-primary-nav"
                       asp-controller="Shows"
                       asp-action="Index">
                        📋 Целосен Календар
                    </a>
                </div>
            </div>

            <div class="theatre-bg">
                <div class="theatre-content">
                    <div class="calendar">
                        <div class="calendar-header">
                            <div class="dow">Пон</div>
                            <div class="dow">Вто</div>
                            <div class="dow">Сре</div>
                            <div class="dow">Чет</div>
                            <div class="dow">Пет</div>
                            <div class="dow">Саб</div>
                            <div class="dow">Нед</div>
                        </div>

                        <div class="calendar-grid">
                            @foreach (var day in days)
                            {
                                var isCurrentMonth = day.Month == firstDay.Month;
                                var isPastDay = day.Date < DateTime.Today;

                                <div class="day-cell @(isCurrentMonth ? "" : "muted-month") @(isPastDay ? "past-day" : "")">
                                    <div class="day-number">@day.Day</div>

                                    <div class="events">
                                        @{
                                            if (!isPastDay && showsByDate.TryGetValue(day.Date, out var dayShows))
                                            {
                                                foreach (var show in dayShows.Take(3))
                                                {
                                                    <a class="event"
                                                       asp-controller="Shows"
                                                       asp-action="Details"
                                                       asp-route-id="@show.Id"
                                                       title="@show.Titile">
                                                        @{
                                                            var shortTitle = show.Titile?.Length > 28 ? show.Titile.Substring(0, 10) + "..." : show.Titile;
                                                        }
                                                        <div class="event-title" title="@show.Titile">@shortTitle</div>
                                                        <div class="event-meta">
                                                            <span class="event-time">🕐 @show.StartTime.ToString("HH:mm")</span>
                                                            <span class="event-price">💰 @show.BasePrice ден</span>
                                                        </div>
                                                    </a>
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="calendar-footer">
                        <strong>Совет:</strong> Минатите претстави се скриени. Кликнете на претстава за да видите слободни седишта.
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
