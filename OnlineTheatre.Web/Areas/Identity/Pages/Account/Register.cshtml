@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap');

    body {
        font-family: 'Montserrat', sans-serif;
    }

    .auth-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .auth-container {
        max-width: 1100px;
        width: 100%;
    }

    /* Auth Card */
    .auth-card {
        background: rgba(10, 10, 12, 0.80);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0,0,0,0.60);
        display: grid;
        grid-template-columns: 1fr 1fr;
        animation: cardFadeIn 0.8s ease-out;
    }

    @@keyframes cardFadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Left Side - Form */
    .auth-form-section {
        padding: 50px 45px;
        position: relative;
    }

    .form-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .form-icon {
        font-size: 3.5rem;
        margin-bottom: 15px;
        animation: iconBounce 1s ease-out;
    }

    @@keyframes iconBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .form-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 10px 0;
        letter-spacing: 0.5px;
    }

    .form-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,0.70);
        font-weight: 500;
    }

    /* Form Styles */
    .auth-form {
        margin-top: 30px;
    }

    .form-group-custom {
        margin-bottom: 20px;
        position: relative;
    }

    .form-label-custom {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255,255,255,0.85);
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }

    .form-control-custom {
        width: 100%;
        padding: 14px 18px;
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.15);
        border-radius: 12px;
        color: #fff;
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .form-control-custom::placeholder {
        color: rgba(255,255,255,0.40);
    }

    .form-control-custom:focus {
        outline: none;
        background: rgba(255,255,255,0.12);
        border-color: rgba(220,53,69,0.60);
        box-shadow: 0 0 0 4px rgba(220,53,69,0.15);
    }

    .text-danger {
        display: block;
        font-size: 0.85rem;
        color: #ff7b8a;
        margin-top: 6px;
        font-weight: 600;
    }

    .validation-summary {
        background: rgba(220,53,69,0.15);
        border: 2px solid rgba(220,53,69,0.40);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        color: #ff7b8a;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* Submit Button */
    .btn-submit {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #dc3545 0%, #a82835 100%);
        border: 2px solid rgba(220,53,69,0.50);
        border-radius: 14px;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.4s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 8px 25px rgba(220,53,69,0.35);
        margin-top: 25px;
    }

    .btn-submit:hover {
        background: linear-gradient(135deg, #e74c5c 0%, #c82333 100%);
        border-color: rgba(220,53,69,0.80);
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(220,53,69,0.50);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    /* Login Link */
    .auth-footer {
        text-align: center;
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid rgba(255,255,255,0.10);
    }

    .auth-footer-text {
        color: rgba(255,255,255,0.70);
        font-size: 0.95rem;
    }

    .auth-link {
        color: #dc3545;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .auth-link:hover {
        color: #ff7b8a;
        text-decoration: underline;
    }

    /* Right Side - Info */
    .auth-info-section {
        background: linear-gradient(135deg, rgba(220,53,69,0.35) 0%, rgba(139,0,0,0.25) 100%);
        padding: 50px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .auth-info-section::before {
        content: "";
        position: absolute;
        top: -2px;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(90deg,
            transparent,
            rgba(220,53,69,0.9) 25%,
            rgba(220,53,69,0.9) 75%,
            transparent);
        box-shadow: 0 0 20px rgba(220,53,69,0.7);
    }

    .info-icon {
        font-size: 5rem;
        text-align: center;
        margin-bottom: 30px;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-15px); }
    }

    .info-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: #fff;
        text-align: center;
        margin-bottom: 20px;
        line-height: 1.3;
    }

    .info-text {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.85);
        text-align: center;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .info-features {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 30px;
    }

    .info-feature {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .info-feature:hover {
        background: rgba(255,255,255,0.12);
        transform: translateX(5px);
    }

    .feature-icon {
        font-size: 1.8rem;
    }

    .feature-text {
        color: rgba(255,255,255,0.90);
        font-weight: 600;
        font-size: 0.95rem;
    }

    /* External Logins */
    .external-logins {
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid rgba(255,255,255,0.10);
    }

    .external-title {
        text-align: center;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.70);
        margin-bottom: 15px;
        font-weight: 600;
    }

    .btn-external {
        width: 100%;
        padding: 12px;
        background: rgba(255,255,255,0.10);
        border: 2px solid rgba(255,255,255,0.20);
        border-radius: 12px;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 10px;
    }

    .btn-external:hover {
        background: rgba(255,255,255,0.15);
        border-color: rgba(255,255,255,0.35);
        transform: translateY(-2px);
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .auth-card {
            grid-template-columns: 1fr;
        }

        .auth-info-section {
            order: -1;
            padding: 40px 30px;
        }

        .auth-form-section {
            padding: 40px 30px;
        }
    }

    @@media (max-width: 768px) {
        .form-title {
            font-size: 2rem;
        }

        .info-title {
            font-size: 1.8rem;
        }

        .auth-form-section,
        .auth-info-section {
            padding: 35px 25px;
        }
    }
</style>

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">

            <!-- Left Side - Form -->
            <div class="auth-form-section">
                <div class="form-header">
                    <div class="form-icon">✨</div>
                    <h1 class="form-title">Регистрација</h1>
                    <p class="form-subtitle">Креирајте нова сметка за да резервирате билети</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">

                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="form-group-custom">
                        <label asp-for="Input.Email" class="form-label-custom">📧 Email адреса</label>
                        <input asp-for="Input.Email" class="form-control-custom" autocomplete="username"
                               aria-required="true" placeholder="vase.ime@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Input.FirstName" class="form-label-custom">👤 Име</label>
                        <input asp-for="Input.FirstName" class="form-control-custom" autocomplete="given-name"
                               aria-required="true" placeholder="Вашето име" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Input.LastName" class="form-label-custom">👤 Презиме</label>
                        <input asp-for="Input.LastName" class="form-control-custom" autocomplete="family-name"
                               aria-required="true" placeholder="Вашето презиме" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Input.Password" class="form-label-custom">🔒 Лозинка</label>
                        <input asp-for="Input.Password" class="form-control-custom" type="password"
                               autocomplete="new-password" aria-required="true" placeholder="Внесете лозинка" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Input.ConfirmPassword" class="form-label-custom">🔒 Потврди Лозинка</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control-custom" type="password"
                               autocomplete="new-password" aria-required="true" placeholder="Повторете лозинка" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn-submit">
                        Регистрирај се
                    </button>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="external-logins">
                            <div class="external-title">Или регистрирајте се со:</div>
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn-external" name="provider" value="@provider.Name"
                                            title="Регистрирајте се со @provider.DisplayName">
                                        @provider.DisplayName
                                    </button>
                                }
                            </form>
                        </div>
                    }

                    <div class="auth-footer">
                        <p class="auth-footer-text">
                            Веќе имате сметка?
                            <a class="auth-link" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Најавете се</a>
                        </p>
                    </div>

                </form>
            </div>

            <!-- Right Side - Info -->
            <div class="auth-info-section">
                <div class="info-icon">🎭</div>
                <h2 class="info-title">Добредојдовте во Online Theatre</h2>
                <p class="info-text">
                    Придружете се на нашата заедница и уживајте во најдобрите театарски претстави
                </p>

                <div class="info-features">
                    <div class="info-feature">
                        <div class="feature-icon">🎫</div>
                        <div class="feature-text">Лесна резервација на билети онлајн</div>
                    </div>
                    <div class="info-feature">
                        <div class="feature-icon">📱</div>
                        <div class="feature-text">QR кодови за брз влез</div>
                    </div>
                    <div class="info-feature">
                        <div class="feature-icon">🔔</div>
                        <div class="feature-text">Известувања за нови претстави</div>
                    </div>
                    <div class="info-feature">
                        <div class="feature-icon">⭐</div>
                        <div class="feature-text">Ексклузивни понуди за членови</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
